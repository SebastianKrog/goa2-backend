    {
      "id": "simulation-benchmark",
      "owner": "search maintainers",
      "when": "hot-path changes and release candidate; manual fixed-work evidence run",
      "scope": "Five alternating samples, eight matched iterations per workload; Python validation outside native timers. No reduced or synthetic replacement for the two complete-game inputs.",
      "required_variables": [
        "GOA2_ORACLE_SOURCE",
        "GOA2_FIXTURE_CACHE",
        "GOA2_SEARCH_BINARY",
        "GOA2_BENCHMARK_OUTPUT"
      ],
      "input_files": [
        "GOA2_ORACLE_SOURCE",
        "GOA2_SEARCH_BINARY"
      ],
      "input_directories": [
        "GOA2_FIXTURE_CACHE"
      ],
      "output_paths": [
        "GOA2_BENCHMARK_OUTPUT"
      ],
      "commands": [
        {
          "argv": [
            "${PYTHON}",
            "${ROOT}/rust/tools/fixtures.py",
            "verify",
            "--full",
            "--family",
            "complete-games-hanu"
          ]
        },
        {
          "argv": [
            "${PYTHON}",
            "${ROOT}/scripts/rust_oracle/run_pinned.py",
            "simulation_bench",
            "--worker",
            "${GOA2_SEARCH_BINARY}",
            "--samples",
            "5",
            "--iterations",
            "8",
            "--compare-rollback",
            "--output",
            "${GOA2_BENCHMARK_OUTPUT}"
          ]
        }
      ]
    },
    {
      "id": "strength-baseline",
      "owner": "search maintainers",
      "when": "search-policy changes and release candidate; manual matched evaluation",
      "scope": "Pinned tuning-map LONG self-play baseline with the source-defined fixed policy/paired starts; report quality separately from simulation throughput. Command defaults are pinned by bridge hashes.",
      "required_variables": [
        "GOA2_ORACLE_SOURCE",
        "GOA2_SEARCH_BINARY"
      ],
      "input_files": [
        "GOA2_ORACLE_SOURCE",
        "GOA2_SEARCH_BINARY"
      ],
      "commands": [
        {
          "argv": [
            "${PYTHON}",
            "${ROOT}/scripts/rust_oracle/run_pinned.py",
            "rollout_parity",
            "--worker",
            "${GOA2_SEARCH_BINARY}",
            "--strength-baseline",
            "--strength-map",
            "forgotten_island",
            "--strength-game-type",
            "LONG"
          ]
        }
      ]
    },
    {
      "id": "hosted-local-contract",
      "owner": "service/release maintainers",
      "when": "hosted provisioning/draft changes and pre-promotion; explicitly selected local compatible Python service",
      "scope": "Disposable native process/database and in-process compatible Python hosted adapter. This does not exercise deployed Worker/Access routing.",
      "required_variables": [
        "GOA2_SERVICE_PYTHON",
        "GOA2_SERVICE_SOURCE",
        "GOA2_GAME_BINARY",
        "GOA2_GAME_CONTENT"
      ],
      "input_files": [
        "GOA2_SERVICE_PYTHON",
        "GOA2_GAME_BINARY",
        "GOA2_GAME_CONTENT"
      ],
      "input_directories": [
        "GOA2_SERVICE_SOURCE"
      ],
      "commands": [
        {
          "argv": [
            "${GOA2_SERVICE_PYTHON}",
