  "execution_policy": "validate/show do not run gates. Required inputs are explicit; missing files fail before execution. Hosts and credentials are supplied only by the caller. Reference sweeps are not claimed passed by catalog validation.",
  "gates": [
    {
      "id": "setup-parity",
      "owner": "engine maintainers",
      "when": "setup/content changes, weekly reference backstop, release candidate",
      "scope": "All supplied setup cases; test asserts a nonempty opening-state/identity comparison.",
      "required_variables": [
        "GOA2_GAME_CONTENT",
        "GOA2_GAME_SETUP_CASES"
      ],
      "input_files": [
        "GOA2_GAME_CONTENT",
        "GOA2_GAME_SETUP_CASES"
      ],
      "commands": [
        {
          "argv": [
            "cargo",
            "test",
            "--manifest-path",
            "${ROOT}/rust/Cargo.toml",
            "--locked",
            "--profile",
            "iterate",
            "-p",
            "goa2-core",
            "--test",
            "live_game_setup",
            "native_setup_matches_pinned_python",
            "--",
            "--ignored",
            "--exact",
            "--nocapture"
          ],
          "minimum_tests": 1
        }
      ]
    },
    {
      "id": "view-parity",
      "owner": "engine/service maintainers",
      "when": "view/privacy changes, weekly reference backstop, release candidate",
