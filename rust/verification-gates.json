            "${GOA2_GAME_CONTENT}"
          ]
        }
      ],
      "environment": {
        "PYTHONPATH": "${GOA2_SERVICE_SOURCE}"
      }
    },
    {
      "id": "hosted-staging-readonly",
      "owner": "release maintainers",
      "when": "explicit deployed-frontend integration verification before promotion",
      "scope": "Read-only verification of a named untimed staging game, ingress and reconnect. No --exercise/--exercise-draft writes are included. Existing verifier reads its Access and player/spectator credentials from the environment.",
      "required_variables": [
        "GOA2_FRONTEND_ORIGIN",
        "GOA2_RUST_ORIGIN",
        "GOA2_STAGING_GAME_ID",
        "GOA2_RELEASE_MANIFEST"
      ],
      "input_files": [
        "GOA2_RELEASE_MANIFEST"
      ],
      "commands": [
        {
          "argv": [
            "${PYTHON}",
            "${ROOT}/scripts/verify_rust_staging.py",
            "--frontend-origin",
            "${GOA2_FRONTEND_ORIGIN}",
            "--rust-origin",
            "${GOA2_RUST_ORIGIN}",
            "--game-id",
            "${GOA2_STAGING_GAME_ID}",
            "--manifest",
            "${GOA2_RELEASE_MANIFEST}"
          ]
        }
      ]
    }
  ]
